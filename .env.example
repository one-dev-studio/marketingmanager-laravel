APP_NAME="Marketing Manager"
VITE_APP_NAME="Marketing Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Subdirectory staging example: https://oneinternetmedia.com/marketingmanager
APP_URL=http://localhost

# Inertia (phase 0+): client-side only until SSR is explicitly enabled
INERTIA_SSR_ENABLED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketpulse
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
# Optional CACHE_STORE overrides CACHE_DRIVER (Laravel 11+); leave unset to use CACHE_DRIVER.
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

OPENAI_API_KEY=
GEMINI_API_KEY=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_APP_SECRET=
INSTAGRAM_WEBHOOK_APP_SECRET=
TWITTER_CONSUMER_SECRET=
LINKEDIN_WEBHOOK_SECRET=
TIKTOK_CLIENT_SECRET=
PINTEREST_WEBHOOK_SECRET=
SENTRY_LARAVEL_DSN=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
