APP_NAME="Marketing Manager"
VITE_APP_NAME="Marketing Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Subdirectory staging example: https://oneinternetmedia.com/marketingmanager
APP_URL=http://localhost

# Inertia (phase 0+): client-side only until SSR is explicitly enabled
INERTIA_SSR_ENABLED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketpulse
# DB_USERNAME=root
# DB_PASSWORD=

# Real-time (Laravel Echo + Pusher). Use log/null locally; set pusher + credentials on staging/production.
# BROADCAST_CONNECTION is an alias for BROADCAST_DRIVER on Laravel 11+.
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
# Optional CACHE_STORE overrides CACHE_DRIVER (Laravel 11+); leave unset to use CACHE_DRIVER.
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

OPENAI_API_KEY=
GEMINI_API_KEY=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_APP_SECRET=
INSTAGRAM_WEBHOOK_APP_SECRET=
TWITTER_CONSUMER_SECRET=
LINKEDIN_WEBHOOK_SECRET=
TIKTOK_CLIENT_SECRET=
PINTEREST_WEBHOOK_SECRET=
SENTRY_LARAVEL_DSN=
# Vite embeds these at build time — mirror PUSHER_* or set explicitly before npm run build.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
